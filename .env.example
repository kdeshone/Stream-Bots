# ── Discord ──────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id
DISCORD_WELCOME_CHANNEL_ID=channel_id_for_welcome_messages
DISCORD_ALERTS_CHANNEL_ID=channel_id_for_go_live_alerts
DISCORD_LOG_CHANNEL_ID=channel_id_for_mod_logs

# ── Twitch ────────────────────────────────────────────────────────────────────
TWITCH_BOT_TOKEN=oauth:your_twitch_oauth_token
TWITCH_BOT_NICK=your_bot_username
TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# ── YouTube ───────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
# Path to OAuth2 credentials JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# ── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_USERNAME=your_tiktok_username

# ── Shared ────────────────────────────────────────────────────────────────────
# Command prefix used across all platforms
COMMAND_PREFIX=!
# Comma-separated list of trusted Twitch/Discord usernames (skip moderation)
TRUSTED_USERS=streamowner,moderator1
# Comma-separated banned words (auto-delete messages containing these)
BANNED_WORDS=
# Social links surfaced by !socials command
SOCIAL_DISCORD=https://discord.gg/yourlink
SOCIAL_TWITCH=https://twitch.tv/yourchannel
SOCIAL_YOUTUBE=https://youtube.com/@yourchannel
SOCIAL_TIKTOK=https://tiktok.com/@yourchannel
